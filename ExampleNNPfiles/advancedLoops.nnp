asciiToCh! <- 10 -> \n

1 -> i
2 -> j



-1 loop j < 7
   
    1 -> i
    [ "inner" ] loop i < 10
        speak! <- j ~-> StrObj + " "
        i + 1 -> i

        if i = 5
            9 -> i
            j + 1 -> j
            [ "inner" ] loop <-
            speak! <- "Should not appear!"
        no

    no
    speak! <- \n
    j + 1 -> j
no

speak! <- \n + "Finished" + \n
